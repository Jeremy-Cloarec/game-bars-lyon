{
    "compilerOptions": {
        "target": "ES2023",
        "module": "ESNext",
        "outDir": "./dist",
        "rootDir": "./app",
        "moduleResolution": "bundler",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "ignoreDeprecations": "6.0",
        "forceConsistentCasingInFileNames": true
    },
    "include": [
        "app/**/*.ts"
    ],
    "exclude": [
        "node_modules"
    ]
}